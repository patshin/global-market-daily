{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patshin.github.io/global-market-daily/schemas/market-lens.schema.json",
  "title": "Global Market Daily 30-Day Market Lens",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "as_of",
    "window_start",
    "window_end",
    "window_calendar_days",
    "coverage",
    "current",
    "regime_distribution",
    "days",
    "regime_transitions",
    "persistent_themes",
    "cross_asset_validation",
    "asset_series",
    "theme_registry",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "generated_at": { "type": "string" },
    "as_of": { "type": "string", "format": "date" },
    "window_start": { "type": "string", "format": "date" },
    "window_end": { "type": "string", "format": "date" },
    "window_calendar_days": { "const": 30 },
    "coverage": {
      "type": "object",
      "required": ["market_sessions", "native_daily_days", "objective_reconstruction_days", "history_days_retained", "day1_ready"],
      "properties": {
        "market_sessions": { "type": "integer", "minimum": 12 },
        "native_daily_days": { "type": "integer", "minimum": 1 },
        "objective_reconstruction_days": { "type": "integer", "minimum": 10 },
        "history_days_retained": { "type": "integer", "minimum": 150 },
        "day1_ready": { "const": true }
      }
    },
    "current": { "type": "object" },
    "regime_distribution": { "type": "array", "minItems": 4, "maxItems": 4 },
    "days": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["date", "regime_code", "regime_label", "source_mode", "signals", "catalysts", "risks", "market"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "regime_code": { "enum": ["risk_on", "neutral", "risk_off", "event_risk"] },
          "source_mode": { "enum": ["native_daily", "objective_market_reconstruction"] },
          "catalysts": { "type": "array", "minItems": 1, "maxItems": 3 },
          "risks": { "type": "array", "minItems": 1, "maxItems": 3 },
          "signals": {
            "type": "object",
            "required": ["growth", "inflation", "rates", "earnings", "liquidity", "geopolitics"]
          }
        }
      }
    },
    "regime_transitions": { "type": "array" },
    "persistent_themes": { "type": "array", "minItems": 3 },
    "cross_asset_validation": { "type": "object" },
    "asset_series": { "type": "array", "minItems": 5 },
    "theme_registry": { "type": "object" },
    "provenance": { "type": "object" }
  }
}
