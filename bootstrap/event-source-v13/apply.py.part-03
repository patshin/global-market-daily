    text = text.replace('''    if (!paragraphs.length && !tables.length && key !== "top_catalysts" && !hasStructuredEarnings) {''', '''    if (!paragraphs.length && !tables.length && key !== "top_catalysts" && !hasStructuredEarnings && !hasEventGroups) {''', 1)
    APP.write_text(text, encoding='utf-8')


def patch_css():
    text = CSS.read_text(encoding='utf-8')
    if 'Cross-section event collections (v1.3.0)' not in text:
        text += r'''

/* ========================================================================== */
/* Cross-section event collections (v1.3.0)                                  */
/* ========================================================================== */

.section-event-groups {
  display: grid;
  gap: 34px;
  margin-top: 28px;
}

.section-event-group {
  min-width: 0;
}

.section-event-group__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 11px;
  border-bottom: 2px solid var(--ink);
}

.section-event-group__header h4 {
  margin: 0;
  font-family: var(--serif);
  font-size: 1.28rem;
  line-height: 1.25;
}

.section-event-group__header p {
  max-width: 760px;
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 0.84rem;
  line-height: 1.55;
}

.section-event-group__count {
  flex: 0 0 auto;
  color: var(--accent);
  font-family: var(--mono);
  font-size: 0.76rem;
  font-weight: 700;
}

.section-event-group__list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0;
}

.section-event {
  min-width: 0;
  padding: 22px 22px 25px 0;
  border-bottom: 1px solid var(--hairline);
}

.section-event:nth-child(even) {
  padding-right: 0;
  padding-left: 22px;
  border-left: 1px solid var(--hairline);
}

.section-event__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.section-event__identity {
  min-width: 0;
}

.section-event__eyebrow,
.section-event__label,
.section-event__summary__label,
.section-event__why__label,
.section-event__transmission__label {
  color: var(--accent);
  font-size: 0.74rem;
  line-height: 1.35;
  font-weight: 750;
  letter-spacing: 0.055em;
  text-transform: uppercase;
}

.section-event h5 {
  margin: 5px 0 0;
  font-family: var(--serif);
  font-size: 1.15rem;
  line-height: 1.3;
}

.section-event__chips {
  display: flex;
  flex: 0 0 auto;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 5px;
  max-width: 45%;
}

.section-event__chip {
  padding: 3px 6px;
  border: 1px solid var(--hairline);
  color: var(--charcoal);
  background: var(--white);
  font-size: 0.72rem;
  line-height: 1.3;
}

.section-event__time-grid,
.section-event__facts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  margin: 14px 0;
  border-top: 1px solid var(--hairline);
  border-bottom: 1px solid var(--hairline);
}

.section-event__time,
.section-event__fact {
  min-width: 0;
  padding: 9px 10px;
  border-right: 1px solid var(--hairline);
}

.section-event__time:first-child,
.section-event__fact:first-child {
  padding-left: 0;
}

.section-event__time:last-child,
.section-event__fact:last-child {
  border-right: 0;
}

.section-event__time span,
.section-event__fact dt {
  display: block;
  color: var(--muted);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.section-event__time strong,
.section-event__fact dd {
  display: block;
  margin: 3px 0 0;
  color: var(--ink);
  font-family: var(--mono);
  font-size: 0.81rem;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.section-event__summary,
.section-event__why {
  padding: 11px 0;
  border-bottom: 1px solid var(--hairline);
}

.section-event__summary__value,
.section-event__why__value {
  margin: 5px 0 0;
  color: var(--charcoal);
  font-family: var(--serif);
  font-size: 0.94rem;
  line-height: 1.65;
}

.section-event__transmission {
  margin: 14px 0;
  padding: 13px 14px;
  border-left: 4px solid var(--accent);
  background: var(--paper-deep);
}

.section-event__transmission__value {
  margin: 5px 0 0;
  color: var(--ink);
  font-family: var(--mono);
  font-size: 0.84rem;
  line-height: 1.58;
}

.section-event__assets {
  margin-top: 14px;
}

.section-event__asset-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 7px;
}

.section-event__integrity {
  margin-top: 14px;
  padding: 12px 14px;
  border: 1px solid var(--hairline);
  background: var(--white);
}

.section-event__integrity ul {
  margin: 6px 0 0;
  padding-left: 18px;
}

.section-event__integrity li {
  margin: 3px 0;
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.55;
}

.section-event-group__empty {
  grid-column: 1 / -1;
  margin: 0;
  padding: 18px 0;
  color: var(--muted);
  font-family: var(--serif);
  font-size: 0.96rem;
  line-height: 1.6;
  border-bottom: 1px solid var(--hairline);
}

@media (max-width: 900px) {
  .section-event-group__list {
    display: block;
  }

  .section-event,
  .section-event:nth-child(even) {
    padding: 21px 0 23px;
    border-left: 0;
  }
}

@media (max-width: 560px) {
  .section-event-group__header,
  .section-event__header {
    display: block;
  }

  .section-event-group__count {
    display: inline-block;
    margin-top: 8px;
  }

  .section-event__chips {
    justify-content: flex-start;
    max-width: none;
    margin-top: 10px;
  }

  .section-event__time-grid,
  .section-event__facts {
    display: block;
  }

  .section-event__time,
  .section-event__fact,
  .section-event__time:first-child,
  .section-event__fact:first-child {
    padding: 9px 0;
    border-right: 0;
    border-bottom: 1px solid var(--hairline);
  }
}
'''
    CSS.write_text(text, encoding='utf-8')


def patch_schema():
    schema = json.loads(SCHEMA.read_text(encoding='utf-8'))
    defs = schema.setdefault('$defs', {})
    defs.update({
        'eventFact': {
            'type': 'object', 'additionalProperties': False,
            'required': ['label', 'value'],
            'properties': {'label': {'type': 'string', 'minLength': 1}, 'value': {'type': 'string', 'minLength': 1}},
        },
        'sectionEvent': {
            'type': 'object', 'additionalProperties': True,
            'required': ['id', 'title', 'category', 'status', 'summary', 'why_it_matters', 'transmission', 'affected_assets', 'facts', 'integrity', 'sources'],
            'properties': {
                'id': {'type': 'string', 'minLength': 3},
                'title': {'type': 'string', 'minLength': 3},
                'category': {'type': 'string', 'minLength': 2},
                'status': {'type': 'string', 'minLength': 2},
                'importance': {'type': 'string'},
                'actual': {'type': 'string'},
                'time': {'type': 'object', 'additionalProperties': {'type': 'string'}},
                'summary': {'type': 'string', 'minLength': 15},
                'why_it_matters': {'type': 'string', 'minLength': 15},
                'transmission': {'type': 'string', 'minLength': 8},
                'affected_assets': {'type': 'array', 'items': {'type': 'string'}, 'uniqueItems': True},
                'facts': {'type': 'array', 'items': {'$ref': '#/$defs/eventFact'}},
                'integrity': {'type': 'array', 'items': {'type': 'string'}},
                'sources': {'type': 'array', 'items': {'type': 'string'}, 'uniqueItems': True},
            },
        },
        'eventGroup': {
            'type': 'object', 'additionalProperties': False,
            'required': ['id', 'label', 'description', 'items', 'empty_message'],
            'properties': {
                'id': {'type': 'string', 'minLength': 2},
                'label': {'type': 'string', 'minLength': 2},
                'description': {'type': 'string', 'minLength': 5},
