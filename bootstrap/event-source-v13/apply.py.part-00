EVENT_SECTION_KEYS = [
    'us_macro', 'central_banks', 'geopolitics', 'regional_policy',
    'index_changes', 'flows', 'etf', 'options', 'treasury',
    'commodities', 'financing', 'breaking_news',
]


def event(event_id, title, category, status, summary, why, transmission,
          affected, facts, integrity, sources, *, time=None, importance=None,
          actual=None):
    item = {
        'id': event_id,
        'title': title,
        'category': category,
        'status': status,
        'summary': summary,
        'why_it_matters': why,
        'transmission': transmission,
        'affected_assets': affected,
        'facts': [{'label': label, 'value': value} for label, value in facts],
        'integrity': integrity,
        'sources': sources,
    }
    if time:
        item['time'] = time
    if importance:
        item['importance'] = importance
    if actual is not None:
        item['actual'] = actual
    return item


def group(group_id, label, description, items, empty_message):
    return {
        'id': group_id,
        'label': label,
        'description': description,
        'items': items,
        'empty_message': empty_message,
    }


